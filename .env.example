# Server
PORT=3100
STRICT_PORT=false
HOST=127.0.0.1
SESSION_HOURS=12
COOKIE_SECURE=false

# Local / single-computer deployment (default)
DB_ENGINE=sqlite
SQLITE_PATH=./data/pos.db
BACKUP_DIR=./backups

# Production PostgreSQL alternative
# DB_ENGINE=postgres
# HOST_PORT=3100
# POSTGRES_PASSWORD=CHANGE_ME
# DATABASE_URL=postgresql://coffee_pos:CHANGE_ME@db:5432/coffee_pos

# Optional report email delivery (Gmail-compatible TLS SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
REPORT_EMAIL_TO=
